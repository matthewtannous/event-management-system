<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mat.frontend.controller.HomeController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <top>
        <HBox alignment="CENTER" spacing="25">
            <Button text="Home" onAction="#handleHome"/>
            <Button text="All Events" onAction="#handleAllEvents"/>
            <Button text="Participating" onAction="#handleEventsParticipating"/>
            <Button text="Organizing" onAction="#handleEventsOrganizing"/>
            <Button text="Logout" onAction="#handleLogout"/>
        </HBox>
    </top>
    <center>
        <Label fx:id="messageLabel" text="Hello There"/>
    </center>

    <bottom>
        <Label fx:id="informationLabel"/>
    </bottom>


</BorderPane>
