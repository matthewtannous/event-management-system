<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mat.frontend.controller.HomeController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <top>
        <HBox alignment="CENTER" spacing="25">
            <Button text="Home" onAction="#handleHome"/>
            <Button text="Events" onAction="#handleEventsNavigator"/>
            <Button text="Logout" onAction="#handleLogout"/>
        </HBox>
    </top>
    <center>
        <Label fx:id="messageLabel" text="Hello There"/>

        <VBox alignment="CENTER" spacing="25">
            <HBox alignment="CENTER" spacing="15">
                <Label text="Username: "/>
                <Label fx:id="usernameLabel"/>
            </HBox>

            <HBox alignment="CENTER" spacing="15">
                <Label text="First Name: "/>
                <Label fx:id="firstNameLabel"/>
            </HBox>

            <HBox alignment="CENTER" spacing="15">
                <Label text="Last Name: "/>
                <Label fx:id="lastNameLabel"/>
            </HBox>

            <HBox alignment="CENTER" spacing="15">
                <Label text="Email: "/>
                <Label fx:id="emailLabel"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <Label fx:id="informationLabel"/>
    </bottom>

</BorderPane>
