<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mat.frontend.controller.EventsNavigatorController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <top>
        <HBox alignment="CENTER" spacing="25">
            <Button text="Home" onAction="#handleHome"/>
            <Button text="Events" onAction="#handleEventsNavigator"/>
            <Button text="Logout" onAction="#handleLogout"/>
        </HBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="25">
            <Button text="Participating" onAction="#handleEventsParticipating"/>
            <Button text="Organizing" onAction="#handleEventsOrganizing"/>
            <Button text="All events" onAction="#handleAllEvents"/>

            <Button text="Create event" onAction="#handleCreateEvent"/>

            <Label fx:id="informationLabel"/>
        </VBox>
    </center>
</BorderPane>
