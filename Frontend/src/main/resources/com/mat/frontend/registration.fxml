<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mat.frontend.controller.RegistrationController">
    <Label text="Registration Form"/>

    <TextField fx:id="usernameField"
               promptText="Enter username"
               maxWidth="250"/>

    <TextField fx:id="firstNameField"
               promptText="Enter first name"
               maxWidth="250"/>

    <TextField fx:id="lastNameField"
               promptText="Enter last name"
               maxWidth="250"/>

    <TextField fx:id="emailField"
               promptText="Enter email"
               maxWidth="250"/>

    <PasswordField
            fx:id="passwordField"
            promptText="Enter Password"
            maxWidth="250"/>

    <PasswordField
            fx:id="confirmPasswordField"
            promptText="Confirm Password"
            maxWidth="250"/>

    <HBox alignment="CENTER" spacing="15">
        <Button
                text="Register"
                onAction="#handleRegister"/>

        <Button
                text="Clear"
                onAction="#handleClear"/>

        <Button text="Login" onAction="#handleLogin"/>
    </HBox>

    <Label
            fx:id="messageLabel"
            wrapText="true"/>
</VBox>
